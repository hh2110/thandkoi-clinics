# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See config/settings/base.py / dev.py for how these are read (django-environ).
# Everything below has a working local-dev default except ANTHROPIC_API_KEY;
# uncomment and set a var only when you need to override its default.

# Required to exercise any AI-calling code path (newsletter draft, daily
# summary sentence, translation) — no fallback, KeyErrors if unset.
# apps/pipeline/ai.py reads this directly.
ANTHROPIC_API_KEY=

# Postgres connection string. Defaults to the local docker-compose DB
# (postgres://thandkoi:thandkoi@localhost:5432/thandkoi) if unset — set this
# only if you're pointing at something else (e.g. a Neon branch).
# DATABASE_URL=

# Defaults to True in dev (config/settings/dev.py).
# DEBUG=True

# Dev ships a safe placeholder key, fine for local use. Only set this if you
# need to mirror a production-like value.
# SECRET_KEY=

# Defaults to localhost/127.0.0.1/0.0.0.0 in dev.
# ALLOWED_HOSTS=localhost,127.0.0.1

# Used in Wagtail notification emails etc. Defaults to http://localhost:8000.
# WAGTAILADMIN_BASE_URL=http://localhost:8000
